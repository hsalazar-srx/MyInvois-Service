<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  Sample MyInvois e-Invoice (UBL 2.1 Format)
  This is the expected output after transformation from MOVEX
  
  Key Validation Points:
  - Supplier TIN in correct format
  - Buyer name and TIN present
  - Invoice date in ISO 8601 (YYYY-MM-DD)
  - All line items with classification codes
  - Digital signature (would be populated during submission)
-->
<Invoice xmlns="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2"
         xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
         xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
  
  <cbc:UBLVersionID>2.1</cbc:UBLVersionID>
  <cbc:ID>INV-2026-00001</cbc:ID>
  <cbc:IssueDate>2026-02-01</cbc:IssueDate>
  <cbc:IssueTime>10:30:00</cbc:IssueTime>
  <cbc:DocumentCurrencyCode>MYR</cbc:DocumentCurrencyCode>
  
  <!-- Supplier (Accounting Supplier Party) -->
  <cac:AccountingSupplierParty>
    <cac:Party>
      <cbc:WebsiteURI>https://example.com</cbc:WebsiteURI>
      <cac:PartyIdentification>
        <cbc:ID schemeID="TIN">123456789012</cbc:ID>
      </cac:PartyIdentification>
      <cac:PartyIdentification>
        <cbc:ID schemeID="BRN">001122334455</cbc:ID>
      </cac:PartyIdentification>
      <cac:PartyName>
        <cbc:Name>PT Technology Solutions Sdn Bhd</cbc:Name>
      </cac:PartyName>
      <cac:PostalAddress>
        <cbc:StreetName>Jalan Teknologi</cbc:StreetName>
        <cbc:CityName>Kuala Lumpur</cbc:CityName>
        <cbc:PostalZone>50400</cbc:PostalZone>
        <cac:Country>
          <cbc:IdentificationCode>MY</cbc:IdentificationCode>
        </cac:Country>
      </cac:PostalAddress>
      <cac:PartyLegalEntity>
        <cbc:RegistrationName>PT Technology Solutions Sdn Bhd</cbc:RegistrationName>
        <cbc:CompanyID schemeID="TIN">123456789012</cbc:CompanyID>
      </cac:PartyLegalEntity>
    </cac:Party>
  </cac:AccountingSupplierParty>
  
  <!-- Buyer (Accounting Customer Party) -->
  <cac:AccountingCustomerParty>
    <cac:Party>
      <cac:PartyIdentification>
        <cbc:ID schemeID="TIN">987654321098</cbc:ID>
      </cac:PartyIdentification>
      <cac:PartyIdentification>
        <cbc:ID schemeID="BRN">556677889900</cbc:ID>
      </cac:PartyIdentification>
      <cac:PartyName>
        <cbc:Name>ABC Corporation (M) Sdn Bhd</cbc:Name>
      </cac:PartyName>
      <cac:PostalAddress>
        <cbc:StreetName>Jalan Perdagangan</cbc:StreetName>
        <cbc:CityName>Shah Alam</cbc:CityName>
        <cbc:PostalZone>40400</cbc:PostalZone>
        <cac:Country>
          <cbc:IdentificationCode>MY</cbc:IdentificationCode>
        </cac:Country>
      </cac:PostalAddress>
      <cac:PartyLegalEntity>
        <cbc:RegistrationName>ABC Corporation (M) Sdn Bhd</cbc:RegistrationName>
        <cbc:CompanyID schemeID="TIN">987654321098</cbc:CompanyID>
      </cac:PartyLegalEntity>
    </cac:Party>
  </cac:AccountingCustomerParty>
  
  <!-- Invoice Lines -->
  <cac:InvoiceLine>
    <cbc:ID>1</cbc:ID>
    <cbc:InvoicedQuantity unitCode="EA">1</cbc:InvoicedQuantity>
    <cbc:LineExtensionAmount currencyID="MYR">1000.00</cbc:LineExtensionAmount>
    <cac:Item>
      <cbc:Name>Software License - Annual Subscription</cbc:Name>
      <cbc:ClassifiedTaxCategory>
        <cbc:ID>SR</cbc:ID>
        <cbc:Percent>6</cbc:Percent>
      </cbc:ClassifiedTaxCategory>
    </cac:Item>
    <cac:Price>
      <cbc:PriceAmount currencyID="MYR">1000.00</cbc:PriceAmount>
    </cac:Price>
    <cac:TaxTotal>
      <cbc:TaxAmount currencyID="MYR">60.00</cbc:TaxAmount>
    </cac:TaxTotal>
  </cac:InvoiceLine>
  
  <!-- Totals -->
  <cac:LegalMonetaryTotal>
    <cbc:LineExtensionAmount currencyID="MYR">1000.00</cbc:LineExtensionAmount>
    <cbc:TaxExclusiveAmount currencyID="MYR">1000.00</cbc:TaxExclusiveAmount>
    <cbc:TaxInclusiveAmount currencyID="MYR">1060.00</cbc:TaxInclusiveAmount>
    <cbc:PayableAmount currencyID="MYR">1060.00</cbc:PayableAmount>
  </cac:LegalMonetaryTotal>
  
  <!-- Digital Signature (populated during submission) -->
  <!-- <ext:UBLExtensions>
    <ext:UBLExtension>
      <ext:ExtensionContent>
        <ds:Signature>...</ds:Signature>
      </ext:ExtensionContent>
    </ext:UBLExtension>
  </ext:UBLExtensions> -->
  
</Invoice>
