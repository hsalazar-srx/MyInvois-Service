<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>myinvois-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Must match the EF Core version pinned in MyInvois.Service.csproj. Used directly by
         Program.cs (EnsureCreated at startup). A mismatch fails restore with NU1605. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.31" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Enrichers.CorrelationId" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyInvois.Service\MyInvois.Service.csproj" />
  </ItemGroup>

</Project>
