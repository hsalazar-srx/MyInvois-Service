#!/bin/sh
# Pre-Commit Hook: Skills Audit Validation — bash shim
# Delegates to pre-commit.ps1 using whichever PowerShell is available.
# Works in MSYS2/MinGW (Git Bash on Windows) and native POSIX shells.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NonInteractive -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_DIR/pre-commit.ps1" "$@"
elif command -v powershell.exe >/dev/null 2>&1; then
    exec powershell.exe -NonInteractive -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_DIR/pre-commit.ps1" "$@"
else
    echo "WARNING: Neither 'pwsh' nor 'powershell.exe' found — skipping skills audit hook." >&2
    exit 0
fi
